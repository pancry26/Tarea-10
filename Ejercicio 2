
import javax.swing.*;
import java.awt.*;

public class Main extends JFrame {

    private JTextField[] campos = new JTextField[7];
    private double[] temperaturas = new double[7];
    private Grafico panelGrafico = new Grafico();

    private String[] dias = {
        "Lun", "Mar", "Mie", "Jue",
        "Vie", "Sab", "Dom"
    };

    public Main() {
        setTitle("Temperaturas Semanales");
        setSize(850, 550);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout());

        JPanel formulario = new JPanel(
            new GridLayout(2, 7, 5, 5));

        for (int i = 0; i < 7; i++) {
            formulario.add(
                new JLabel(dias[i], SwingConstants.CENTER));
        }

        for (int i = 0; i < 7; i++) {
            campos[i] = new JTextField("20");
            formulario.add(campos[i]);
        }

        JButton btnMostrar = new JButton("Mostrar Grafico");

        JPanel superior = new JPanel(new BorderLayout());
        superior.add(formulario, BorderLayout.CENTER);
        superior.add(btnMostrar, BorderLayout.SOUTH);

        add(superior, BorderLayout.NORTH);
        add(panelGrafico, BorderLayout.CENTER);

        btnMostrar.addActionListener(e -> {
            try {
                for (int i = 0; i < 7; i++) {
                    temperaturas[i] = Double.parseDouble(
                        campos[i].getText().trim());

                    if (!Double.isFinite(temperaturas[i])) {
                        throw new NumberFormatException();
                    }
                }
                panelGrafico.repaint();

            } catch (NumberFormatException ex) {
                JOptionPane.showMessageDialog(
                    this, "Ingrese temperaturas numericas validas.");
            }
        });
    }

    class Grafico extends JPanel {

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);

            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(
                RenderingHints.KEY_ANTIALIASING,
                RenderingHints.VALUE_ANTIALIAS_ON);

            int izquierda = 65;
            int derecha = getWidth() - 45;
            int arriba = 50;
            int abajo = getHeight() - 65;

            if (derecha <= izquierda || abajo <= arriba) {
                return;
            }

            double min = temperaturas[0];
            double max = temperaturas[0];

            for (double t : temperaturas) {
                min = Math.min(min, t);
                max = Math.max(max, t);
            }

            if (min == max) {
                min -= 1;
                max += 1;
            }

            g2.setColor(Color.BLACK);
            g2.drawLine(izquierda, arriba,
                        izquierda, abajo);
            g2.drawLine(izquierda, abajo,
                        derecha, abajo);

            g2.setColor(Color.BLUE);
            g2.setStroke(new BasicStroke(2));

            int anteriorX = 0;
            int anteriorY = 0;

            for (int i = 0; i < 7; i++) {
                int x = izquierda +
                    i * (derecha - izquierda) / 6;

                int y = abajo - (int)(
                    (temperaturas[i] - min) /
                    (max - min) * (abajo - arriba));

                g2.fillOval(x - 4, y - 4, 8, 8);

                if (i > 0) {
                    g2.drawLine(anteriorX, anteriorY, x, y);
                }

                g2.setColor(Color.BLACK);
                g2.drawString(dias[i], x - 12, abajo + 20);
                g2.drawString(
                    String.format("%.1f", temperaturas[i]),
                    x - 15, y - 12);

                g2.setColor(Color.BLUE);
                anteriorX = x;
                anteriorY = y;
            }
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() ->
            new Main().setVisible(true));
    }
}

